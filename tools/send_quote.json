{
  "type": "webhook",
  "name": "send_quote",
  "description": "Creates a formal Stripe quote (quote number, 30-day expiry, PDF) from a priced order. Call this after calculate_quote once the caller is happy with the price and wants it formalized. Pass the dealer details and the exact lines array returned by calculate_quote. Read back the spoken_summary verbatim, including the quote number. Never invent quote numbers. If the caller gave a promo code and check_promo_code said it is valid, pass it as promo_code. If promo_code is rejected, read back the spoken_summary; the quote is unchanged. Stripe Tax calculates sales tax from the ship-to ZIP code: if the result has needs_postal_code true, ask the caller for the ZIP code and call send_quote again with dealer.postal_code.",
  "disable_interruptions": false,
  "interruption_mode": "allow",
  "force_pre_tool_speech": false,
  "pre_tool_speech": "auto",
  "tool_call_sound": null,
  "tool_call_sound_behavior": "auto",
  "tool_error_handling_mode": "auto",
  "execution_mode": "immediate",
  "follow_redirects": false,
  "follow_redirects_allowed_domains": [],
  "api_schema": {
    "url": "https://YOUR-STRIPE-VAL.web.val.run/quote",
    "method": "POST",
    "path_params_schema": [],
    "query_params_schema": [],
    "request_body_schema": {
      "id": "body",
      "type": "object",
      "description": "The priced order to turn into a Stripe quote",
      "properties": [
        {
          "id": "quote_id",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "The quote_id returned by calculate_quote, for example Q-204815",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": true
        },
        {
          "id": "dealer",
          "type": "object",
          "description": "The caller's dealer details",
          "properties": [
            {
              "id": "id",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Dealer number, for example D-1042",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": false
            },
            {
              "id": "name",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Dealer or company name",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": true
            },
            {
              "id": "email",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Email for the invoice, if the caller gives one",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": false
            },
            {
              "id": "phone",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Caller's phone number in E.164 format, for example +14175550142",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": false
            },
            {
              "id": "postal_code",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "5-digit ZIP code the order ships to, used by Stripe Tax, for example 78704",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": false
            }
          ],
          "required": true,
          "dynamic_variable": "",
          "value_type": "llm_prompt"
        },
        {
          "id": "lines",
          "type": "array",
          "description": "The exact lines array returned by calculate_quote",
          "items": {
            "id": "lines_item",
            "type": "object",
            "description": "One quote line",
            "properties": [
              {
                "id": "product",
                "type": "string",
                "value_type": "llm_prompt",
                "description": "Product name",
                "dynamic_variable": "",
                "constant_value": "",
                "enum": null,
                "is_system_provided": false,
                "required": true
              },
              {
                "id": "qty",
                "type": "number",
                "value_type": "llm_prompt",
                "description": "Quantity",
                "dynamic_variable": "",
                "constant_value": "",
                "enum": null,
                "is_system_provided": false,
                "required": true
              },
              {
                "id": "unit_net",
                "type": "number",
                "value_type": "llm_prompt",
                "description": "Net unit price after discounts, in dollars",
                "dynamic_variable": "",
                "constant_value": "",
                "enum": null,
                "is_system_provided": false,
                "required": true
              },
              {
                "id": "billing",
                "type": "string",
                "value_type": "llm_prompt",
                "description": "one_time or monthly",
                "dynamic_variable": "",
                "constant_value": "",
                "enum": null,
                "is_system_provided": false,
                "required": true
              },
              {
                "id": "volume_discount_pct",
                "type": "number",
                "value_type": "llm_prompt",
                "description": "Volume discount percent applied, if any",
                "dynamic_variable": "",
                "constant_value": "",
                "enum": null,
                "is_system_provided": false,
                "required": false
              },
              {
                "id": "extra_discount_pct",
                "type": "number",
                "value_type": "llm_prompt",
                "description": "Extra discount percent applied, if any",
                "dynamic_variable": "",
                "constant_value": "",
                "enum": null,
                "is_system_provided": false,
                "required": false
              }
            ],
            "required": false,
            "dynamic_variable": "",
            "value_type": "llm_prompt"
          },
          "required": true,
          "dynamic_variable": "",
          "value_type": "llm_prompt"
        },
        {
          "id": "promo_code",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "A promo code to apply, only if check_promo_code returned valid true for it on this call. Leave empty otherwise.",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": false
        }
      ],
      "required": false,
      "dynamic_variable": "",
      "value_type": "llm_prompt"
    },
    "request_headers": [],
    "content_type": "application/json",
    "auth_connection": null,
    "mtls_auth_connection": null,
    "response_filter": null
  },
  "assignments": [],
  "response_timeout_secs": 30,
  "dynamic_variables": {
    "dynamic_variable_placeholders": {}
  },
  "response_mocks": []
}