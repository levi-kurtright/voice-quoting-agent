{
  "type": "webhook",
  "name": "check_promo_code",
  "description": "Checks whether a promo code the caller mentions is valid in Stripe and what it gives. Read-only; never changes anything. Call it as soon as the caller mentions a promo, coupon, or discount code, before sending the quote. Pass the code exactly as the caller says it (letters and digits, no spaces), and the dealer. Read back the spoken_summary. If valid is false, do not apply the code and do not offer any other discount.",
  "disable_interruptions": false,
  "interruption_mode": "allow",
  "force_pre_tool_speech": false,
  "pre_tool_speech": "auto",
  "tool_call_sound": null,
  "tool_call_sound_behavior": "auto",
  "tool_error_handling_mode": "auto",
  "execution_mode": "immediate",
  "follow_redirects": false,
  "follow_redirects_allowed_domains": [],
