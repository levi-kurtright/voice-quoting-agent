{
  "type": "webhook",
  "name": "log_follow_up",
  "description": "Logs a tracked follow-up for a human billing specialist and returns a reference number. Call it every time you tell a caller that a specialist will follow up: a cancellation request, a credit over the phone limit, a dispute, an issue over 5,000 dollars, an upset caller who wants a person, a plan exception, or a payment problem you cannot resolve. Call it before you end that part of the conversation, then read back the spoken_summary, including the reference number. Never promise a specialist follow-up without logging it.",
  "disable_interruptions": false,
  "interruption_mode": "allow",
  "force_pre_tool_speech": false,
  "pre_tool_speech": "auto",
  "tool_call_sound": null,
  "tool_call_sound_behavior": "auto",
  "tool_error_handling_mode": "auto",
  "execution_mode": "immediate",
  "follow_redirects": false,
  "follow_redirects_allowed_domains": [],
  "api_schema": {
    "url": "https://YOUR-STRIPE-VAL.web.val.run/followup?agent=quinn",
    "method": "POST",
    "path_params_schema": [],
    "query_params_schema": [],
    "request_body_schema": {
      "id": "body",
      "type": "object",
      "description": "Request body",
      "properties": [
        {
          "id": "dealer",
          "type": "object",
          "description": "The caller's account. Provide at least one identifier.",
          "properties": [
            {
              "id": "id",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Dealer number, for example D-1042",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": false
            },
            {
              "id": "email",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Email on the account",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": false
            },
            {
              "id": "name",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Company or dealer name",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": false
            }
          ],
          "required": false,
          "dynamic_variable": "",
          "value_type": "llm_prompt"
        },
        {
          "id": "reason",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "Why a specialist is needed",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": [
            "cancellation",
            "credit_over_limit",
            "dispute",
            "high_value",
            "upset_caller",
            "plan_change_exception",
            "payment_problem",
            "other"
          ],
          "is_system_provided": false,
          "required": true
        },
        {
          "id": "summary",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "One or two factual sentences a specialist can act on: what the caller wants, the key numbers, and what you already told them",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": true
        },
        {
          "id": "amount",
          "type": "number",
          "value_type": "llm_prompt",
          "description": "Dollar amount involved, if any",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": false
        },
        {
          "id": "invoice_number",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "The invoice or quote number involved, if any",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": false
        }
      ],
      "required": false,
      "dynamic_variable": "",
      "value_type": "llm_prompt"
    },
    "request_headers": [],
    "content_type": "application/json",
    "auth_connection": null,
    "mtls_auth_connection": null,
    "response_filter": null
  },
  "assignments": [],
  "response_timeout_secs": 30,
  "dynamic_variables": {
    "dynamic_variable_placeholders": {}
  },
  "response_mocks": []
}
