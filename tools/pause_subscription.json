{
  "type": "webhook",
  "name": "pause_subscription",
  "description": "Pauses billing on a dealer's toner subscription for one or two billing months instead of canceling; Stripe skips those invoices and resumes on its own. Use when a caller wants to cancel or pause a toner subscription because business is slow or they are overstocked: offer the pause first. First call with confirmed false: it reads back which invoices are skipped and when billing restarts. Call again with confirmed true only after the caller clearly says yes. If the caller does not say how many printers and the dealer has several toner subscriptions, the tool asks which one. Print plans cannot be paused. Read back the spoken_summary word for word.",
  "disable_interruptions": false,
  "interruption_mode": "allow",
  "force_pre_tool_speech": false,
  "pre_tool_speech": "auto",
  "tool_call_sound": null,
  "tool_call_sound_behavior": "auto",
  "tool_error_handling_mode": "auto",
  "execution_mode": "immediate",
  "follow_redirects": false,
  "follow_redirects_allowed_domains": [],
  "api_schema": {
    "url": "https://YOUR-STRIPE-VAL.web.val.run/subscription/pause",
    "method": "POST",
    "path_params_schema": [],
    "query_params_schema": [],
    "request_body_schema": {
      "id": "body",
      "type": "object",
      "description": "Request body",
      "properties": [
        {
          "id": "dealer",
          "type": "object",
          "description": "The caller's dealer account",
          "properties": [
            {
              "id": "id",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Dealer number, for example D-3002",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": true
            },
            {
              "id": "name",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Dealer or company name, if the caller gave it",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": false
            }
          ],
          "required": true,
          "dynamic_variable": "",
          "value_type": "llm_prompt"
        },
        {
          "id": "months",
          "type": "number",
          "value_type": "llm_prompt",
          "description": "How many billing months to pause: 1 or 2",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": true
        },
        {
          "id": "printers",
          "type": "number",
          "value_type": "llm_prompt",
          "description": "Number of printers on the toner subscription to pause, if the caller said it or the tool asked which one",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": false
        },
        {
          "id": "confirmed",
          "type": "boolean",
          "value_type": "llm_prompt",
          "description": "false to read back the pause first; true only after the caller clearly said yes",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": true
        }
      ],
      "required": false,
      "dynamic_variable": "",
      "value_type": "llm_prompt"
    },
    "request_headers": [],
    "content_type": "application/json",
    "auth_connection": null,
    "mtls_auth_connection": null,
    "response_filter": null
  },
  "assignments": [],
  "response_timeout_secs": 30,
  "dynamic_variables": {
    "dynamic_variable_placeholders": {}
  },
  "response_mocks": []
}
