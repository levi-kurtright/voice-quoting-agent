{
  "type": "webhook",
  "name": "change_subscription",
  "description": "Applies a subscription quantity change in Stripe and invoices the prorated difference. Call this only after preview_subscription_change, and only once the caller clearly says yes. Pass new_quantity and proration_date exactly as preview_subscription_change returned them. Read back the spoken_summary word for word. Never invent amounts or invoice numbers.",
  "disable_interruptions": false,
  "interruption_mode": "allow",
  "force_pre_tool_speech": false,
  "pre_tool_speech": "auto",
  "tool_call_sound": null,
  "tool_call_sound_behavior": "auto",
  "tool_error_handling_mode": "auto",
  "execution_mode": "immediate",
  "follow_redirects": false,
  "follow_redirects_allowed_domains": [],
  "api_schema": {
    "url": "https://YOUR-STRIPE-VAL.web.val.run/subscription/change",
    "method": "POST",
    "path_params_schema": [],
    "query_params_schema": [],
    "request_body_schema": {
      "id": "body",
      "type": "object",
      "description": "The confirmed subscription change",
      "properties": [
        {
          "id": "dealer",
          "type": "object",
          "description": "The caller's account. Provide at least one identifier.",
          "properties": [
            {
              "id": "id",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Dealer number, for example D-1042",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": false
            },
            {
              "id": "email",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Email on the account",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": false
            },
            {
              "id": "name",
              "type": "string",
              "value_type": "llm_prompt",
              "description": "Company or dealer name",
              "dynamic_variable": "",
              "constant_value": "",
              "enum": null,
              "is_system_provided": false,
              "required": false
            }
          ],
          "required": true,
          "dynamic_variable": "",
          "value_type": "llm_prompt"
        },
        {
          "id": "product",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "Which subscription to change, in the caller's words, for example toner",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": true
        },
        {
          "id": "new_quantity",
          "type": "number",
          "value_type": "llm_prompt",
          "description": "new_quantity exactly as returned by preview_subscription_change",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": true
        },
        {
          "id": "proration_date",
          "type": "number",
          "value_type": "llm_prompt",
          "description": "proration_date exactly as returned by preview_subscription_change",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": true
        }
      ],
      "required": false,
      "dynamic_variable": "",
      "value_type": "llm_prompt"
    },
    "request_headers": [],
    "content_type": "application/json",
    "auth_connection": null,
    "mtls_auth_connection": null,
    "response_filter": null
  },
  "assignments": [],
  "response_timeout_secs": 30,
  "dynamic_variables": {
    "dynamic_variable_placeholders": {}
  },
  "response_mocks": []
}
